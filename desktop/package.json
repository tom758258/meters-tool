{
  "name": "meters-tool-desktop",
  "version": "3.1.2",
  "private": true,
  "productName": "Meters Tool",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs",
    "dist:win": "electron-builder --dir --win --x64"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "directories": {
      "output": "../dist/desktop"
    },
    "win": {
      "icon": "assets/meters-icon.ico"
    },
    "files": [
      "main.cjs"
    ]
  }
}
